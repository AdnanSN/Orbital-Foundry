# Orbital Foundry API keys. Fill these in your .env (which is git-ignored).
# Never paste keys into chat and never commit them.

# Sandbox lane: development and testing only (NVIDIA's trial terms forbid production use).
# https://build.nvidia.com -> sign in -> API Keys -> Generate. Starts with "nvapi-".
NVIDIA_API_KEY=

# Live lane: FLUX.1-schnell images (~170 free per day) and small text/vision models.
# Cloudflare dashboard -> Workers AI -> "Use REST API": copy the Account ID and create a token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional fallbacks. Sandbox lane only until their terms are checked in Stage 7.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
